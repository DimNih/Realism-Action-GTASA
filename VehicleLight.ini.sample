intensity=0.72
range=30
bloom=0.18
white=0.38
bounce=0.70
dynamic_light=1
world=0.30
shadow=0
shadow_building=1
shadow_building_strength=1.10
shadow_building_range=82
; Complex Shadow: outline comes from the model DFF. Old shadow_* keys still work.
complex_shadow_dff=1
shadow_vehicles=1
shadow_peds=0
; shadow texture orientation 0..7 (1 mirror side, 2 mirror front/back, 4 swap axes).
; Leave 0. If a shadow looks reversed (its base is not attached to the object) try 2, then 1, 3...
shadow_orient=0
; ---- High-quality interactive shader shadows for every visible GTA surface.
; This takes priority over complex ground decals when enabled and can hit
; buildings, props, vehicles, peds and CJ without bleeding through depth edges.
; Every visible object (buildings, props, trees, vehicles, peds) casts and receives, per pixel.
sun_shadow=1
sun_shadow_strength=1.00
sun_shadow_range=70
sun_shadow_map=1024
sun_shadow_soft=1.00
sun_shadow_mesh=1
sun_shadow_mesh_count=48
; 0 = geometry casters only (stable), 1 = also screen-depth splats (noisy), 2 = splats only when casters are missing
sun_shadow_splat=2
sun_shadow_ambient=0.42
sun_shadow_selfshade=0.65
sun_shadow_thick=1.0
sun_shadow_density=5
sun_shadow_contact=1
sun_shadow_quality=0
; Native GTA shadows are disabled while sun_shadow=1; this key is retained for compatibility.
sun_shadow_native=0
; 0 = sun from the game clock (default), 1 = the game's own sun vector if it can be read (see VehicleLight.log)
sun_source=0
; debug: 1 = shadow-map visibility, 2 = cascades (red near, green far), 3 = normals, 4 = contact only
sun_shadow_debug=0
